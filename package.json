{
	"name": "payload-template-project",
	"version": "1.0.0",
	"description": "Get started quickly with Next.js, Payload, MongoDB, and Tailwind CSS.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start"
	},
	"dependencies": {
		"@payloadcms/db-mongodb": "3.86.0",
		"@payloadcms/next": "3.86.0",
		"@payloadcms/richtext-lexical": "3.86.0",
		"@payloadcms/ui": "3.86.0",
		"cross-env": "^7.0.3",
		"dotenv": "16.4.7",
		"graphql": "^16.8.1",
		"next": "16.2.6",
		"payload": "3.86.0",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"sharp": "0.34.2",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "22.19.9",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"eslint": "^9.16.0",
		"eslint-config-next": "16.2.6",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "28.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tsx": "4.22.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.7.3"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10 || ^11"
	}
}
