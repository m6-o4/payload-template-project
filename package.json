{
	"name": "payload-template-project",
	"version": "1.0.0",
	"description": "Get started quickly with Next.js, Payload CMS and MongoDB.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@clerk/backend": "^3.13.1",
		"@clerk/nextjs": "^7.6.1",
		"@payloadcms/db-mongodb": "3.86.0",
		"@payloadcms/next": "3.86.0",
		"@payloadcms/richtext-lexical": "3.86.0",
		"@payloadcms/ui": "3.86.0",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "17.4.2",
		"graphql": "^17.0.2",
		"lucide-react": "^1.27.0",
		"next": "16.2.12",
		"payload": "3.86.0",
		"postcss": "^8.5.23",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shadcn": "^4.15.0",
		"sharp": "0.35.3",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"eslint": "^10.8.0",
		"eslint-config-next": "16.2.12",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "30.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tsx": "4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10 || ^11"
	}
